    "retained_release_assets_and_refs": "rc.6 source/mirror and both CodeSeal releases unchanged before/after"
  },
  "executor_source": "\"\"\"Exact rc.5 native-release retirement. Default is a read-only preflight.\"\"\"\nimport datetime, hashlib, json, os, re, subprocess, sys\nfrom pathlib import Path\n\nROOT=Path(__file__).parent\nKNOWN={('mylife-inc/Zellij','v0.2.0-rc.5'):442694651,('mylife-inc/releases','zellij-v0.2.0-rc.5'):442694716}\nassert sys.argv[1:] in [[],['--apply','v0.2.0-rc.6']]\napply=bool(sys.argv[1:])\nraw=(ROOT/'plan.json').read_bytes()\ndigest=hashlib.sha256(raw).hexdigest()\nassert os.environ.get('RETIRE_PLAN_SHA256')==digest,'Reviewed plan hash does not match'\nplan=json.loads(raw)\nassert plan['schema']==1 and plan['status']=='reviewed' and plan['replacement']=='v0.2.0-rc.6'\nassert {(t['repository'],t['tag']):t['id'] for t in plan['targets']}==KNOWN\nassert len(plan['targets'])==2 and len(plan['protected'])==4\nassert {p['tag'] for p in plan['protected']}=={'v0.2.0-rc.6','zellij-v0.2.0-rc.6','codeseal-v1.1.0','codeseal-v1.0.4'}\n\ndef api(endpoint,method='GET',missing=False):\n    p=subprocess.run(['gh','api','--hostname','github.com','--method',method,endpoint],text=True,capture_output=True,timeout=60)\n    if p.returncode:\n        code=re.search(r'HTTP (\\d+)',p.stderr)\n        if missing and code and code[1]=='404':return None\n        raise RuntimeError(f'{method} {endpoint}: HTTP {code[1] if code else p.returncode}')\n    return json.loads(p.stdout) if p.stdout.strip() else None\n\ndef assets(rows):\n    return sorted([dict(id=a['id'],name=a['name'],size=a['size'],digest=a.get('digest')) for a in rows],key=lambda a:a['name'])\n\ndef unchanged_release(row,missing=False):\n    r=api(f'repos/{row[\"repository\"]}/releases/{row[\"id\"]}',missing=missing)\n    if r is not None:\n        assert r['id']==row['id'] and r['tag_name']==row['tag'] and assets(r['assets'])==assets(row['assets']),'Release identity/assets changed'\n        if row['tag'] in ['v0.2.0-rc.6','zellij-v0.2.0-rc.6']:\n            assert not r['draft'] and r['prerelease'] and len(r['assets'])==20,'Replacement must remain a published candidate'\n    return r\n\ndef unchanged_ref(row,missing=False):\n    ref=api(f'repos/{row[\"repository\"]}/git/ref/tags/{row[\"tag\"]}',missing=missing)\n    if ref is not None:assert ref==row['tag_ref'],'Tag identity changed'\n    return ref\n\ndef protected():\n    for row in plan['protected']:\n        assert unchanged_release(row) is not None\n        assert unchanged_ref(row) is not None\n\ndef heads():\n    for repo,head in plan['repository_heads'].items():\n        assert api(f'repos/{repo}/commits/main')['sha']==head,f'{repo} main moved; re-review'\n\ndef gates():\n    assert len(plan['gates'])==13,'Require source, public, Homebrew, six consumer builds, development images, two published images and fresh HTTP checks'\n    for g in plan['gates']:\n        r=api(f'repos/{g[\"repository\"]}/actions/runs/{g[\"run\"]}')\n        assert r['status']=='completed' and r['conclusion']=='success' and r['head_sha']==g['head'],f'Acceptance gate changed: {g}'\n\nheads();gates();protected()\nfor row in plan['targets']:\n    r=unchanged_release(row,missing=True)\n    if r is not None:assert not r.get('immutable',False)\n    unchanged_ref(row,missing=True)\n    print(('REMOVE' if apply else 'PLAN'),row['repository'],row['tag'],row['id'],len(row['assets']),'assets',flush=True)\nif not apply:\n    print('Read-only preflight passed. No deletion.');sys.exit(0)\n\nout=ROOT/'result.json'\nreport=json.loads(out.read_text()) if out.exists() else {'plan_sha256':digest,'replacement':plan['replacement'],'started_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'events':[]}\nassert report['plan_sha256']==digest\nreport['complete']=False\ndef save():out.write_text(json.dumps(report,indent=2)+'\\n')\nsave()\ntry:\n    for row in plan['targets']:\n        heads()\n        repo,tag,rid=row['repository'],row['tag'],row['id']\n        current=unchanged_release(row,missing=True)\n        unchanged_ref(row,missing=True)\n        if current is not None:\n            assert not current.get('immutable',False)\n            api(f'repos/{repo}/releases/{rid}','DELETE')\n            report['events'].append(dict(repository=repo,tag=tag,id=rid,action='deleted-release',assets=len(row['assets'])));save()\n        if unchanged_ref(row,missing=True) is not None:\n            api(f'repos/{repo}/git/refs/tags/{tag}','DELETE')\n            report['events'].append(dict(repository=repo,tag=tag,action='deleted-tag'));save()\n        assert api(f'repos/{repo}/releases/tags/{tag}',missing=True) is None\n        assert api(f'repos/{repo}/git/ref/tags/{tag}',missing=True) is None\n    protected();report['complete']=True\n    report['finished_at']=datetime.datetime.now(datetime.timezone.utc).isoformat()\nexcept Exception as error:\n    report['error']=str(error);raise\nfinally:save()\nprint('Retired exactly two rc.5 releases, 40 assets and two tags. rc.6 and CodeSeal identities are unchanged.')\n",
  "guard_test_source": "\"\"\"Exercise deletion guards with a fake API. No network or real GitHub calls.\"\"\"\nimport hashlib,json,os,shutil,subprocess,sys,tempfile\nfrom pathlib import Path\nsource=Path(__file__).parent\nwith tempfile.TemporaryDirectory(prefix='zel-native-retire-guards-') as temp:\n    root=Path(temp);shutil.copy(source/'retire.py',root/'retire.py')\n    plan=json.loads((source/'plan-draft.json').read_text());plan['status']='reviewed'\n    plan['repository_heads']={'mylife-inc/Zellij':'fixture-head'}\n    plan['gates']=[{'repository':'mylife-inc/Zellij','run':i+1,'head':'fixture-head'} for i in range(13)]\n    for row in plan['protected']:row['tag_ref']={'ref':'refs/tags/'+row['tag'],'object':{'sha':'fixture-ref'}}\n    raw=(json.dumps(plan)+'\\n').encode();(root/'plan.json').write_bytes(raw)\n    (root/'gh').write_text('#!'+sys.executable+'\\n'+'''\nimport json,os,sys\nfrom pathlib import Path\nr=Path(__file__).parent;args=sys.argv[1:];method=args[args.index('--method')+1];endpoint=args[-1]\nwith (r/'calls.jsonl').open('a') as f:f.write(json.dumps({'method':method,'endpoint':endpoint})+'\\\\n')\nassert method=='GET','A failed preflight must never mutate GitHub'\np=json.loads((r/'plan.json').read_text());scenario=os.environ['SCENARIO']\nif endpoint.endswith('/commits/main'):value={'sha':'moved' if scenario=='head' else 'fixture-head'}\nelif '/actions/runs/' in endpoint:value={'status':'completed','conclusion':'failure' if scenario=='gate' else 'success','head_sha':'fixture-head'}\nelse:\n rows=p['targets']+p['protected'];row=next(x for x in rows if endpoint.startswith('repos/'+x['repository']+'/') and (endpoint.endswith('/releases/'+str(x['id'])) or endpoint.endswith('/git/ref/tags/'+x['tag'])))\n if '/git/ref/' in endpoint:\n  value=row['tag_ref'].copy()\n  if scenario=='ref':value['object']={'sha':'moved'}\n else:\n  value={'id':row['id'],'tag_name':row['tag'],'assets':row['assets'],'draft':scenario=='draft','prerelease':True}\n  if scenario=='asset':value['assets']=[]\nprint(json.dumps(value))\n''');(root/'gh').chmod(0o700)\n    for scenario in ['hash','head','gate','asset','ref','draft','good']:\n        calls=root/'calls.jsonl';calls.unlink(missing_ok=True)\n        env={**os.environ,'PATH':str(root)+os.pathsep+os.environ['PATH'],'SCENARIO':scenario,'RETIRE_PLAN_SHA256':'wrong' if scenario=='hash' else hashlib.sha256(raw).hexdigest()}\n        result=subprocess.run([sys.executable,str(root/'retire.py'),*([] if scenario=='good' else ['--apply','v0.2.0-rc.6'])],env=env,capture_output=True,text=True)\n        assert (result.returncode==0)==(scenario=='good'),(scenario,result.stderr)\n        requests=[json.loads(line) for line in calls.read_text().splitlines()] if calls.exists() else []\n        assert all(r['method']=='GET' for r in requests)\n        assert not (root/'result.json').exists()\n        print(scenario,'guard passed; no mutation')\n"
}
