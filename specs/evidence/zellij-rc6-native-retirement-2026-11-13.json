  "executor_sha256": "b32ce031ad56d7c938da31fa6a19f3e441db76c55cd831958c412c30be491673",
  "verification": {
    "guard_tests_passed": 7,
    "mutations_prevented_for": [
      "wrong plan hash",
      "moved main",
      "failed acceptance",
      "changed asset inventory",
