{
  "name": "@shebka/zellij-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Reference Zellij wrapper app \u2014 the development playground and visual test bed.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "assets": "node scripts/make-placeholder-assets.mjs",
    "predev": "npm run assets && zellij prepare",
    "dev": "next dev",
    "prebuild": "npm run assets && zellij prepare",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "verify:basepath": "node scripts/verify-basepath.mjs"
  },
  "dependencies": {
    "@shebka/zellij": "*",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
