+/* Private qualification only: call the three modified libraries after linking. */
+extern const char *kpathsea_version_string;
+extern void gr_engine_version(int *, int *, int *);
+extern char *zzip_strerror(int);
+int zellijRelinkProof(void) {
+    int major = 0, minor = 0, patch = 0, result = 0;
+    gr_engine_version(&major, &minor, &patch);
+    if (strstr(kpathsea_version_string, "ZEL_RELINK_KPATHSEA")) result |= 1;
+    if (major == 1 && minor == 3 && patch == 77) result |= 2;
+    if (!strcmp(zzip_strerror(0), "ZEL_RELINK_ZZIPLIB")) result |= 4;
+    return result;
+}
