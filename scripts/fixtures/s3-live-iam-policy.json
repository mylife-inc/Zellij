{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectAccountPublicAccessOnly",
      "Effect": "Allow",
      "Action": "s3:GetAccountPublicAccessBlock",
      "Resource": "*"
    },
    {
      "Sid": "CreateOnlyOhioAcceptanceBuckets",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::zellij-live-*",
      "Condition": { "StringEquals": { "s3:LocationConstraint": "us-east-2" } }
    },
    {
      "Sid": "ConfigureAndRemoveAcceptanceBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket", "s3:GetBucketLocation", "s3:GetBucketVersioning", "s3:PutBucketOwnershipControls",
        "s3:GetBucketTagging", "s3:PutBucketTagging", "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketPolicy", "s3:GetBucketWebsite", "s3:PutBucketWebsite", "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::zellij-live-*"
    },
    {
      "Sid": "UploadInspectAndRemoveFixtureObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::zellij-live-*/portable/*", "arn:aws:s3:::zellij-live-*/hosted/*"]
    }
  ]
}
