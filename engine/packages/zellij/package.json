{
  "name": "@shebka/zellij",
  "version": "0.1.0",
  "zellij": {
    "wrapperConfigVersion": 1,
    "featureSelectionVersion": 1
  },
  "description": "A shared Next.js engine that turns a folder of structured content into a complete product website.",
  "license": "UNLICENSED",
  "author": "Shebka LLC",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./content": "./src/content/index.ts",
    "./config": "./src/config/index.ts",
    "./styles.css": "./src/styles/zellij.css",
    "./next-config": "./next-config.mjs",
    "./disabled-feature": "./disabled-feature.mjs",
    "./optional-maths": "./optional-maths.mjs",
    "./optional-mermaid": "./optional-mermaid.mjs"
  },
  "bin": {
    "zellij": "./bin/zellij.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "README.md",
    "next-config.mjs",
    "deployment-config.cjs",
    "deployment-config.d.cts",
    "feature-config.cjs",
    "feature-config.d.cts",
    "optional-maths.mjs",
    "optional-maths.d.mts",
    "disabled-feature.mjs",
    "optional-mermaid.mjs",
    "optional-mermaid.d.mts"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup && node scripts/fix-cjs-directives.mjs && node scripts/prepare-fonts.mjs && node scripts/verify-build.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": "~16.4.2",
    "react": "19.2.x",
    "react-dom": "19.2.x",
    "mermaid": "^11.17.2",
    "rehype-mathjax": "^7.1.0",
    "remark-math": "^6.0.0"
  },
  "dependencies": {
    "@plausible-analytics/tracker": "0.4.6",
    "@shikijs/rehype": "^4.3.1",
    "@shikijs/transformers": "^4.3.1",
    "d3-hierarchy": "^3.1.2",
    "d3-shape": "^3.2.0",
    "flexsearch": "^0.8.212",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^1.28.0",
    "next-mdx-remote": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.3.1",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vite": "^7.3.7",
    "mermaid": "^11.17.2",
    "rehype-mathjax": "^7.1.0",
    "remark-math": "^6.0.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./content": {
        "types": "./dist/content/index.d.ts",
        "import": "./dist/content/index.js",
        "require": "./dist/content/index.cjs"
      },
      "./config": {
        "types": "./dist/config/index.d.ts",
        "import": "./dist/config/index.js",
        "require": "./dist/config/index.cjs"
      },
      "./styles.css": "./src/styles/zellij.css",
      "./disabled-feature": "./disabled-feature.mjs",
      "./optional-maths": "./optional-maths.mjs",
      "./optional-mermaid": "./optional-mermaid.mjs"
    }
  },
  "overrides": {
    "mermaid": {
      "katex": "^0.18.2"
    },
    "micromark-extension-math": {
      "katex": "^0.18.2"
    },
    "speech-rule-engine": {
      "@xmldom/xmldom": "^0.9.12"
    }
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    },
    "rehype-mathjax": {
      "optional": true
    },
    "remark-math": {
      "optional": true
    }
  }
}
