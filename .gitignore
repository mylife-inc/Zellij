node_modules/
.next/
out/
dist/
*.tsbuildinfo

# Zellij copies content assets here during the sync step (see spec §13.4)
examples/*/public/_zellij/

.DS_Store
*.log
npm-debug.log*
.env
.env.local
.claude/settings.local.json
coverage/
test-results/
playwright-report/
engine/packages/zellij/dist/
# PayOS guide pages are converted from MkDocs sources by scripts/convert-docs.mjs.
# The sidebars and the hand-written index are not, so they stay tracked.
examples/payos/content/01-guide/*.mdx
!examples/payos/content/01-guide/index.mdx
examples/payos/content/02-using-payos/*.mdx

# Rust build output
cli/target/

# Local Netlify folder
.netlify

# Cross-compile output from `zrelease-local`, which builds the Linux binary in
# a container with its own target and cargo home so it cannot fight the native
# build for the same lock files.
cli/target-gnu/
cli/.cargo-gnu/
