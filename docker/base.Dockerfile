# syntax=docker/dockerfile:1
#
# The Zellij base image: a Next.js wrapper app with the engine already
# installed, and nothing else. It carries no content — a site image is built
# FROM this one by copying a content folder in.
#
# This is how Zellij is distributed. The source repository is private; this
# image is not, so anyone can build a site without access to the engine. It is
# also how the wrapper app is obtained without cloning: see `docker cp` below.

# --------------------------------------------------------------- engine build
FROM node:22-alpine AS engine

WORKDIR /src

# The manifests alone first, so a change to the engine's source does not
# invalidate the dependency layer.
COPY package.json package-lock.json ./
COPY engine/packages/zellij/package.json engine/packages/zellij/
RUN npm ci --ignore-scripts

COPY engine/ engine/
RUN npm run build --workspace @shebka/zellij

# Strip the package to what a consumer needs: the build output, the CLI, the
# stylesheet source the app imports, and the manifests. The engine's own
# sources, tests and tooling stay behind.
RUN mkdir -p /out \
 && cd engine/packages/zellij \
 && cp -r package.json next-config.mjs bin dist src /out/


# ------------------------------------------------------------------ base image
FROM node:22-alpine AS base

# `git` is absent on purpose: nothing here clones anything, and leaving it out
# keeps the attack surface down.
RUN apk add --no-cache libc6-compat

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    ZELLIJ_OUTPUT=standalone

# The engine lives outside /app so that copying a content folder into /app can
# never overwrite it.
COPY --from=engine /out /opt/zellij

WORKDIR /app

# The wrapper is generated by the engine's own scaffold rather than written
# here, so the image cannot drift from what `zellij init` produces for someone
# working locally.
RUN node /opt/zellij/bin/zellij.mjs init /app --force --name zellij-site \
 && npm pkg set 'dependencies.@shebka/zellij'='file:/opt/zellij' \
 && npm install --omit=dev --install-links \
 && npm cache clean --force

# A placeholder so the image builds and runs on its own. A site image replaces
# it wholesale.
# `content/` is deliberately the last thing added: it is the only layer that
# changes between one site and the next.

LABEL org.opencontainers.image.source="https://github.com/mylife-inc/Zellij" \
      org.opencontainers.image.description="Next.js wrapper with the Zellij engine installed. Copy a content folder into /app/content and build." \
      org.opencontainers.image.licenses="UNLICENSED"

CMD ["node", "/opt/zellij/bin/zellij.mjs", "--help"]
